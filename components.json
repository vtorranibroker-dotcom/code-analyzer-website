@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

/* =====================================================
   DESIGN SYSTEM: Industrial Precision
   Movement: Swiss Grid / Industrial Design
   Colors: Ivory #F5F4F0, Near-black #1A1A1A, Industrial Red #D4380D, Technical Blue #003A8C
   Typography: Bebas Neue (display), Inter (body)
   ===================================================== */

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
}

:root {
  --radius: 0.125rem; /* Near-zero radius for industrial feel */
  --background: oklch(0.975 0.005 85);   /* Ivory #F5F4F0 */
  --foreground: oklch(0.15 0.005 65);    /* Near-black #1A1A1A */
  --card: oklch(0.98 0.003 85);
  --card-foreground: oklch(0.15 0.005 65);
  --popover: oklch(0.98 0.003 85);
  --popover-foreground: oklch(0.15 0.005 65);
  --primary: oklch(0.28 0.12 255);       /* Technical Blue #003A8C */
  --primary-foreground: oklch(0.975 0.005 85);
  --secondary: oklch(0.92 0.005 85);
  --secondary-foreground: oklch(0.15 0.005 65);
  --muted: oklch(0.93 0.005 85);
  --muted-foreground: oklch(0.45 0.01 65);
  --accent: oklch(0.48 0.22 30);         /* Industrial Red #D4380D */
  --accent-foreground: oklch(0.975 0.005 85);
  --destructive: oklch(0.48 0.22 30);
  --destructive-foreground: oklch(0.985 0 0);
  --border: oklch(0.82 0.008 85);
  --input: oklch(0.82 0.008 85);
  --ring: oklch(0.28 0.12 255);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    font-family: 'Inter', sans-serif;
  }
  button:not(:disabled),
  [role="button"]:not([aria-disabled="true"]),
  [type="button"]:not(:disabled),
  [type="submit"]:not(:disabled),
  a[href],
  select:not(:disabled) {
    @apply cursor-pointer;
  }
}

@layer components {
  .container {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .flex {
    min-height: 0;
    min-width: 0;
  }
  @media (min-width: 640px) {
    .container { padding-left: 1.5rem; padding-right: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .container { padding-left: 2rem; padding-right: 2rem; max-width: 1280px; }
  }

  /* Industrial display font utility */
  .font-display {
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 0.02em;
  }

  /* Section number decorative utility */
  .section-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 9rem;
    line-height: 1;
    color: oklch(0.15 0.005 65 / 0.06);
    position: absolute;
    top: -1rem;
    right: 0;
    user-select: none;
    pointer-events: none;
  }

  /* Thick rule separator */
  .rule-thick {
    border: none;
    border-top: 4px solid oklch(0.15 0.005 65);
  }
  .rule-accent {
    border: none;
    border-top: 4px solid oklch(0.48 0.22 30);
  }
}
